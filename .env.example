# Used by `npm run install:*` and `npm run seed`. Copy to .env (never commit .env).
ATLASSIAN_SITE=your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=
# Confluence space for the demo metric definitions
CONFLUENCE_SPACE_KEY=MET
# Jira project for the demo business requests
JIRA_PROJECT_KEY=MKT
